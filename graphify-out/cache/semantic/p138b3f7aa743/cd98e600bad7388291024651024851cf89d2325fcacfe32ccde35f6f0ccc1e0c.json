{"nodes": [{"id": "docs_architecture_mod_reflectjournal", "label": "mod_reflectjournal (Reflection Journal plugin)", "file_type": "document", "source_file": "docs/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_use_moodle_core_never_reinvent", "label": "Use Moodle core, never reinvent", "file_type": "rationale", "rationale": "Every mechanism maps to a core API recorded in the architecture ledger; anything off the ledger must justify itself in an ADR before being written custom.", "source_file": "docs/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_core_api_ledger", "label": "Core-API mapping ledger", "file_type": "rationale", "rationale": "API names checked against MOODLE_503_STABLE source; docs links are the Moodle 5.3 pages on moodledev.io; plans must name the core API from this ledger (plans/README.md rule 4).", "source_file": "docs/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_plugin_folder_layout", "label": "Component and folder layout (plugin at repo root)", "file_type": "rationale", "rationale": "Repo root is the plugin root mounted at moodle/public/mod/reflectjournal (ADR-0004); business logic in namespaced autoloaded classes/, lib.php stays a thin bridge (core convention); no locallib.php unless a hot path needs it.", "source_file": "docs/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_reflectjournal_table", "label": "reflectjournal table (instance config)", "file_type": "code", "source_file": "docs/architecture.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_reflectjournal_ent