{"nodes": [{"id": "docs_specs_readme", "label": "Specs README (docs/specs/README.md)", "file_type": "document", "source_file": "docs/specs/README.md", "source_location": "header", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_specs_readme_spec_front_matter", "label": "Spec front matter (status/milestone/issue/tickets/adrs)", "file_type": "concept", "source_file": "docs/specs/README.md", "source_location": "Front matter", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_specs_readme_spec_body_template", "label": "Spec body template (/to-spec sections)", "file_type": "concept", "source_file": "docs/specs/README.md", "source_location": "Body template", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The body keeps /to-spec's own template - same sections, same order (Problem Statement, Solution, User Stories, Implementation Decisions, Testing Decisions, Out of Scope, Further Notes); do not invent a second template. Repo note: no specific file paths or code snippets (they go stale), with one exception - a prototype snippet that encodes a decision more precisely than prose may be inlined, trimmed to the decision-rich parts. Testing decisions target the highest existing seam: service classes in classes/, Behat for UI journeys."}, {"id": "docs_specs_readme_spec_lifecycle", "label": "Spec lifecycle (draft -> approved -> on main -> implemented)", "file_type": "rationale", "source_file": "docs/specs/README.md", "source_location": "Lifecycle", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Draft written by the user via /to-spec (synthesizing the /wayfinder or /grill-with-docs conversation; it does not interview); approved flips front matter and files a parent issue linking the spec; the spec lands on main through a small docs PR before tickets are cut so tickets reference a stable path; implemented when all tickets cut from it are merged. Specs are kept forever as portfolio evidence."}, {"id": "docs_specs_readme_repo_overrides_on_to_spec", "label": "Repo-specific overrides on /to-spec", "file_type": "rationale", "source_file": "docs/specs/README.md", "source_location": "Repo-specific overrides", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The canonical artifact is the spec file, not a tracker issue: /to-spec's default ('publish the spec to the issue tracker') becomes writing docs/specs/NNN-slug.md and filing a parent issue that links it. The parent issue gets no ready-for-agent label - that label is for tickets cut by /to-tickets."}, {"id": "docs_specs_readme_docs_agents_triage_labels_md", "label": "docs/agents/triage-labels.md", "file_type": "document", "source_file": "docs/specs/README.md", "source_location": "Repo-specific overrides", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_specs_readme", "target": "docs_adr_0006_spec_and_plan_workflow_canonical_spec_file", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/specs/README.md", "source_location": "header", "weight": 1.0}, {"source": "docs_specs_readme", "target": "docs_adr_0006_spec_and_plan_workflow_docs_workflow_md", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/specs/README.md", "source_location": "header", "weight": 1.0}, {"source": "docs_specs_readme", "target": "docs_adr_0006_spec_and_plan_workflow_to_spec", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/specs/README.md", "source_location": "Body template", "weight": 1.0}, {"source": "docs_specs_readme", "target": "docs_adr_0006_spec_and_plan_workflow_wayfinder", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/specs/README.md", "source_location"