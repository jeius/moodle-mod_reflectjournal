{"nodes": [{"id": "agents_mod_reflectjournal", "label": "Reflection Journal (mod_reflectjournal)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Moodle 5.3 LTS activity module and portfolio piece: teachers post a reflection prompt, learners write one entry before a deadline, teachers give feedback plus an optional gradebook grade."}, {"id": "agents_operating_manual", "label": "AGENTS.md operating manual", "file_type": "document", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_core_api_first", "label": "Core-API-first principle", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every mechanism maps to a Moodle core API (ledger in docs/architecture.md); deviations need an ADR \u2014 keeps the plugin idiomatic and reviewable."}, {"id": "agents_seven_phase_workflow", "label": "Seven-phase workflow (decide, spec, tickets, plan, execute, PR, merge)", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lifecycle with one skill per phase: phases 1-3 run by the user, 4-6 by the agent, merge by the user; worked example in docs/workflow.md."}, {"id": "agents_worktrees_disabled", "label": "Git worktrees disabled", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The docker stack bind-mounts this exact path, so work in place on one feature branch at a time, never on main; sequential subagent implementers only (ADR-0006)."}, {"id": "agents_security_guardrails", "label": "Security guardrails ($DB placeholders, sesskey, capability checks)", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "$DB API with param placeholders only; no raw SQL with user input; required_param/optional_param input; require_sesskey() on writes; require_login + require_capability on every route; walk docs/security-checklist.md per diff; never modify Moodle core."}, {"id": "agents_plugin_conventions", "label": "Plugin coding conventions", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Business logic in namespaced classes/, lib.php a thin bridge, output via renderer + Mustache, strings via get_string(), GPL header + PHPDoc on every PHP file, version.php bump + db/upgrade.php savepoint on schema/capability changes."}, {"id": "agents_github_actions_ci", "label": "GitHub Actions CI (moodle-plugin-ci matrix)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All checks on push: moodle-plugin-ci with php 8.3/8.4 x pgsql/mariadb; phpcs must stay at zero findings (success criterion)."}, {"id": "agents_issue_tracker", "label": "Issue tracker conventions (GitHub Issues via gh)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_triage_labels", "label": "Default triage labels", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "needs-triage, needs-info, ready-for-agent, ready-for-human, wontfix."}, {"id": "agents_domain_docs", "label": "Domain docs convention (GLOSSARY.md + docs/adr/)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_no_deprecated_apis", "label": "No APIs deprecated in Moodle 5.3", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\\external_* classes and FEATURE_GROUPMEMBERSONLY are deprecated in 5.3 and must not be used."}, {"id": "agents_milestones_m0_m9", "label": "Milestones M0-M9", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GitHub milestones mirror docs/plan.md; one PR per issue."}, {"id": "agents_wayfinder_skill", "label": "wayfinder skill (Phase 1: decide)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User-invoked (disable-model-invocation); for foggy/large work, produces a map issue; agent never runs it unasked."}, {"id": "agents_grill_with_docs_skill", "label": "grill-with-docs skill (Phase 1: decide)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User-invoked; for a single feature; yields GLOSSARY.md + docs/adr/ entries; preferred over grilling/grill-me."}, {"id": "agents_to_spec_skill", "label": "to-spec skill (Phase 2: spec)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User-invoked; writes specs/NNN-slug.md plus a parent issue linking it; the parent never duplicates the spec and gets no ready-for-agent label (tickets only); spec reaches main via a small docs PR before tickets are cut."}, {"id": "agents_to_tickets_s