{"nodes": [{"id": "docs_agents_issue_tracker_github_tracker", "label": "GitHub issue tracker (jeius/moodle-mod_reflectjournal via gh CLI)", "file_type": "concept", "source_file": "docs/agents/issue-tracker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All operations via gh; infer repo from git remote; file issues only into the user's own repo and verify with gh repo view before the first gh issue create in a fork; PRs as a triage/request surface set to no."}, {"id": "docs_agents_issue_tracker_sub_issues", "label": "GitHub sub-issues (parent/child links)", "file_type": "concept", "source_file": "docs/agents/issue-tracker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_agents_issue_tracker_native_blocking", "label": "Native issue dependencies (blocked-by edges)", "file_type": "concept", "source_file": "docs/agents/issue-tracker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Canonical, UI-visible blocking via gh blocked-by edges (database ids via the dependencies API); fallback 'Blocked by:' body line; a ticket is unblocked when every blocker is closed; count open blockers with issue_dependencies_summary.blocked_by."}, {"id": "docs_agents_issue_tracker_specs_plans_override", "label": "Spec/plan publication overrides", "file_type": "rationale", "source_file": "docs/agents/issue-tracker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Canonical spec is a committed file specs/NNN-slug.md; '/to-spec' writes the file then a parent issue that only summarizes and links (no ready-for-agent on the parent \u2014 tickets only); '/to-tickets' tickets carry a 'Spec: specs/NNN-slug.md' line and keep native blocked-by edges; these override the skills' publication defaults."}, {"id": "docs_agents_issue_tracker_wayfinder_operations", "label": "Wayfinding operations (map + child tickets)", "file_type": "concept", "source_file": "docs/agents/issue-tracker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used by /wayfinder: a single map issue labelled wayfinder:map holding Notes/Decisions-so-far/Fog, child issues as tickets (wayfinder:<type> labels); frontier query lists open unblocked unassigned children in map order; claim assigns @me; resolve comments, closes, and appends a context pointer to Decisions-so-far; a map's destination is usually a spec, handing off to /to-spec."}], "edges": [{"source": "docs_agents_issue_tracker_native_blocking", "target": "docs_agents_issue_tracker_github_tracker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/agents/issue-tracker.md", "source_location": null, "weight": 1.0}, {"source": "docs_agents_issue_tracker_sub_issues", "target": "docs_agents_issue_tracker_github_tracker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/agents/issue-tracker.md", "source_location": null, "weight": 1.0}, {"source": "docs_agents_issue_tracker_wayfinder_operations", "target": "docs_agents_issue_tracker_github_tracker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/agents/issue-tracker.md", "source_location": null, "weight": 1.0}, {"source": "docs_agents_issue_tracker_wayfinder_operations", "target": "agents_wayfinder_skill", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/agents/issue-tracker.md", "source_location": null, "weight": 1.0}, {"source": "docs_agents_issue_tracker_wayfinder_operations", "target": "agents_to_spec_skill", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/agents/issue-tracker.md", "source_lo