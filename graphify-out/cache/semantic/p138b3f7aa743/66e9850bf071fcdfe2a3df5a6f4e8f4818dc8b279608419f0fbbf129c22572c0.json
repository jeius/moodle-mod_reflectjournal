{"nodes": [{"id": "docs_adr_0005_testing_approach_container_testing", "label": "In-container PHPUnit + Behat testing", "file_type": "rationale", "source_file": "docs/adr/0005-testing-approach.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tests must prove real Moodle behaviour (DB, forms, completion, gradebook) and run locally in WSL2 without host PHP setup; agents need local proof to self-correct, so CI-only is rejected; third-party runners lack Moodle's fixtures/generators. Behat CI uses Chrome, local Firefox \u2014 both stock profiles."}, {"id": "docs_adr_0005_testing_approach_github_actions_ci", "label": "GitHub Actions CI via moodle-plugin-ci (MOODLE_503_STABLE x PHP 8.3/8.4 x pgsql/mariadb)", "file_type": "rationale", "source_file": "docs/adr/0005-testing-approach.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gates every push; workflow modelled on moodle-plugin-ci gha.dist.yml (4.5.11); both DBs from M0 is a success criterion; steps phplint, phpmd (advisory), phpcs (max-warnings 0), phpdoc, validate, savepoints, mustache, grunt, phpunit, behat."}, {"id": "docs_adr_0005_testing_approach_test_generators", "label": "tests/generator.php shared fixture generator (M7)", "file_type": "concept", "source_file": "docs/adr/0005-testing-approach.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_adr_0005_testing_approach_container_testing", "target": "docs_adr_0005_testing_approach_github_actions_ci", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0005-testing-approach.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0005_testing_approach_github_actions_ci", "target": "glossary_moodle_plugin_ci", "relation": "references", "confidence": "EXTRACTED", "confidence_score"