{"nodes": [{"id": "docs_adr_0008_feedbackby_privacy_semantics", "label": "ADR-0008: feedbackby privacy semantics (teacher as data subject)", "file_type": "document", "source_file": "docs/adr/0008-feedbackby-privacy-semantics.md", "source_location": null, "source_url": null, "captured_at": "2026-11-24", "author": null, "contributor": null}, {"id": "docs_adr_0008_feedbackby_privacy_semantics_teacher_data_subject", "label": "Decision: feedback written by a teacher is that teacher's personal data", "file_type": "rationale", "source_file": "docs/adr/0008-feedbackby-privacy-semantics.md", "source_location": null, "source_url": null, "captured_at": "2026-11-24", "author": null, "contributor": null, "rationale": "The feedback is the teacher's substantive work record, not a bookkeeping column; mod_assign treats grader as a data subject; anonymise-only was rejected because the learner normally knows who wrote the feedback, so removing the id alone is not erasure."}, {"id": "docs_adr_0008_feedbackby_privacy_semantics_mod_assign_precedent", "label": "mod_assign grader precedent (assign_grades.grader privacy handling)", "file_type": "concept", "source_file": "docs/adr/0008-feedbackby-privacy-semantics.md", "source_location": null, "source_url": null, "captured_at": "2026-11-24", "author": null, "contributor": null}, {"id": "docs_adr_0008_feedbackby_privacy_semantics_teacher_erasure", "label": "Teacher erasure: feedback text/format/timestamp and files deleted, feedbackby=0, entry and grade untouched", "file_type": "rationale", "source_file": "docs/adr/0008-feedbackby-privacy-semantics.md", "source_location": null, "source_url": null, "captured_at": "2026-11-24", "author": null, "contributor": null, "rationale": "Core deletes authored content in the same situation (delete_marks_for_users()); the grade stays because it is the gradebook's data, not the plugin's (ADR-0007). Accepted cost: a learner can lose feedback text and files when a teacher is erased."}], "edges": [{"source": "d