{"nodes": [{"id": "docs_adr_0004_plugin_mount_bind_mount_bind_mount", "label": "Plugin bind mount via pinned clone's local.yml", "file_type": "rationale", "source_file": "docs/adr/0004-plugin-mount-bind-mount.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The plugin repo sits outside the core checkout, so it must appear inside the container at /var/www/html/public/mod/reflectjournal without copying files or editing core. Symlink into moodle/ dangles inside the container (bind mounts can't follow paths outside the mounted tree); copy/sync drifts; nesting the repo inside moodle/public/mod/ inverts the plugin-at-root layout (ADR-0003) \u2014 all rejected."}, {"id": "docs_adr_0004_plugin_mount_bind_mount_public_web_root", "label": "Moodle 5.x public/ web root", "file_type": "concept", "source_file": "docs/adr/0004-plugin-mount-bind-mount.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verified from the 5.3-versioned docs: module files live at public/mod/[modname]/... since Moodle 5.0, corroborated by the local MOODLE_503_STABLE checkout (has public/, no top-level mod/)."}, {"id": "docs_adr_0004_plugin_mount_bind_mount_shadow_volumes", "label": "Anonymous shadow volumes for repo-local moodle/ and ci/", "file_type": "rationale", "source_file": "docs/adr/0004-plugin-mount-bind-mount.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without shadow volumes, Behat init regenerates the classmap over the nested core copy and dies with 'Cannot declare interface behat_session_interface' (verified 2026-11-23)."}], "edges": [{"source": "docs_adr_0004_plugin_mount_bind_mount_bind_mount", "target": "docs_adr_0004_plugin_mount_bind_mount_public_web_root", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0004-plugin-mount-bind-mount.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0004_plugin_mount_bind_mount_bind_mount", "target": "docs_adr_0004_plugin_mount_bind_mount_shadow_volumes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0004-plugin-mount-bind-mount.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0004_plugin_mount_bind_mount_bind_mount", "target": "docs_adr_0003_repo_layout_pinned_dev_stack", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0004-plugin-mount-bind-mount.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0004_plugin_mount_bind_mount_bind_mount", "target": "docs_adr_0003_repo_layout_plugin_at_root", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0004-plugin-mount-bind-mount.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0004_plugin_mount_bind_mount_bind_mount", "target": "docs_adr_0003_repo_layout_core_checkout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0004-plugin-mount-bind-mount.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0004_plugin_mount_bind_mount_shadow_volumes", "target": "docs_adr_0003_repo_layout_core_checkout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/adr/0004-plugin-mount-bind-mount.md", "source_location": null, "weight": 1.0}, {"source": "docs_adr_0004_plugin_mount_bind_mount_public_web_root", "target": "glossary_public", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/adr/0004-plugin-mount-bind-mount.md", "source_location": null, "weight": 1.0}], "hyperedges": []}